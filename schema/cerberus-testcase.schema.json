{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Cerberus Local Test Metadata",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "testFolder": {
      "type": "string",
      "description": "Identifiant du Test Folder Cerberus dans lequel le testcase est stocké.",
      "title": "Test Folder"
    },
    "testcase": {
      "type": "string",
      "description": "Identifiant du testcase dans Cerberus. Pour un testcase déjà synchronisé, il correspond à l'ID serveur. Pour une création locale, cette valeur est seulement provisoire : elle n'est pas envoyée au POST, Cerberus génère l'ID disponible puis le CLI met à jour ce champ et renomme le dossier local.",
      "title": "Testcase ID",
      "examples": [
        "0001A",
        "mon-nouveau-test"
      ]
    },
    "application": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "detailedDescription": {
      "type": "string"
    },
    "priority": {
      "type": [
        "integer",
        "string"
      ],
      "default": 1
    },
    "status": {
      "type": "string",
      "default": "WORKING"
    },
    "type": {
      "type": "string",
      "default": "AUTOMATED"
    },
    "active": {
      "type": "object",
      "properties": {
        "default": {
          "type": "boolean",
          "default": true
        },
        "QA": {
          "type": "boolean",
          "default": true
        },
        "UAT": {
          "type": "boolean",
          "default": true
        },
        "PROD": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "conditionOperator": {
      "type": "string",
      "default": "always"
    },
    "properties": {
      "type": "array",
      "default": []
    }
  },
  "required": [
    "formatVersion",
    "testFolder",
    "testcase",
    "application",
    "description"
  ],
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Cerberus Local Test Metadata",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "integer",
      "const": 1
    },
    "testFolder": {
      "type": "string",
      "description": "Cerberus test folder ID"
    },
    "testcase": {
      "type": "string",
      "description": "Local provisional testcase identifier. Ignored on creation; Cerberus generates the server testcase ID."
    },
    "application": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "detailedDescription": {
      "type": "string"
    },
    "priority": {
      "type": [
        "integer",
        "string"
      ],
      "default": 1
    },
    "status": {
      "type": "string",
      "default": "WORKING"
    },
    "type": {
      "type": "string",
      "default": "AUTOMATED"
    },
    "active": {
      "type": "object",
      "properties": {
        "default": {
          "type": "boolean",
          "default": true
        },
        "QA": {
          "type": "boolean",
          "default": true
        },
        "UAT": {
          "type": "boolean",
          "default": true
        },
        "PROD": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "conditionOperator": {
      "type": "string",
      "default": "always"
    },
    "properties": {
      "type": "array",
      "default": []
    }
  },
  "required": [
    "formatVersion",
    "testFolder",
    "testcase",
    "application",
    "description"
  ],
  "additionalProperties": true
}
